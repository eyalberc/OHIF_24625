{
  "name": "@ohif/extension-ui-enhancements",
  "version": "3.11.0-beta.58",
  "description": "Comprehensive UI/UX Enhancement Extension for OHIF Viewer v3 - Enhanced toolbar, global patient header, study comparison highlighting, virtual series support, and PRD color system integration",
  "author": "OHIF Enhancement Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/OHIF/Viewers.git",
    "directory": "extensions/ui-enhancements"
  },
  "homepage": "https://github.com/OHIF/Viewers/tree/master/extensions/ui-enhancements",
  "bugs": {
    "url": "https://github.com/OHIF/Viewers/issues"
  },
  "main": "dist/ohif-extension-ui-enhancements.umd.js",
  "module": "src/index.ts",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./dist/ohif-extension-ui-enhancements.umd.js",
      "types": "./dist/index.d.ts"
    },
    "./configs": {
      "import": "./src/configs/extensionConfigTemplates.js",
      "require": "./dist/configs/extensionConfigTemplates.js"
    },
    "./utils": {
      "import": "./src/utils/index.js",
      "require": "./dist/utils/index.js"
    },
    "./services": {
      "import": "./src/services/index.js",
      "require": "./dist/services/index.js"
    },
    "./components": {
      "import": "./src/components/index.js",
      "require": "./dist/components/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0",
    "yarn": ">=1.22.0"
  },
  "files": [
    "dist/**/*",
    "src/**/*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "configs/**/*",
    "!src/**/*.test.js",
    "!src/**/*.test.ts",
    "!src/**/__tests__/**",
    "!**/*.map"
  ],
  "keywords": [
    "ohif-extension",
    "ui-enhancements",
    "medical-imaging",
    "dicom-viewer",
    "healthcare",
    "radiology",
    "virtual-series",
    "patient-header",
    "study-comparison",
    "toolbar-enhancement",
    "color-system",
    "accessibility",
    "medical-workflow"
  ],
  "scripts": {
    "clean": "shx rm -rf dist",
    "clean:deep": "yarn run clean && shx rm -rf node_modules",
    "dev": "cross-env NODE_ENV=development webpack --config .webpack/webpack.dev.js --watch --output-pathinfo",
    "build": "yarn run clean && cross-env NODE_ENV=production webpack --config .webpack/webpack.prod.js",
    "build:dev": "cross-env NODE_ENV=development webpack --config .webpack/webpack.dev.js",
    "build:package": "yarn run build && yarn run build:types",
    "build:types": "tsc --emitDeclarationOnly --outDir dist",
    "start": "yarn run dev",
    "start:dev": "yarn run dev",
    "test": "jest --passWithNoTests",
    "test:unit": "jest src --passWithNoTests",
    "test:integration": "jest src/__tests__ --passWithNoTests",
    "test:watch": "jest --watch --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "validate": "yarn run lint && yarn run type-check && yarn run test",
    "prepare": "yarn run build:package",
    "prepublishOnly": "yarn run validate && yarn run build:package",
    "prepack": "yarn run build:package"
  },
  "peerDependencies": {
    "@ohif/core": "3.11.0-beta.58",
    "@ohif/ui": "3.11.0-beta.58",
    "@ohif/i18n": "3.11.0-beta.58",
    "prop-types": "^15.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dependencies": {
    "@babel/runtime": "^7.20.13",
    "lodash.get": "^4.4.2",
    "lodash.merge": "^4.6.2",
    "lodash.debounce": "^4.0.8",
    "lodash.throttle": "^4.1.1",
    "classnames": "^2.3.2"
  },
  "devDependencies": {
    "@babel/core": "^7.22.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-arrow-functions": "^7.22.5",
    "@babel/plugin-transform-regenerator": "^7.22.10",
    "@babel/plugin-transform-runtime": "^7.22.15",
    "@babel/preset-env": "^7.22.20",
    "@babel/preset-react": "^7.22.15",
    "@babel/preset-typescript": "^7.23.0",
    "@types/lodash.debounce": "^4.0.7",
    "@types/lodash.get": "^4.4.7",
    "@types/lodash.merge": "^4.6.7",
    "@types/lodash.throttle": "^4.1.7",
    "@types/react": "^18.2.25",
    "@types/react-dom": "^18.2.11",
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "@typescript-eslint/parser": "^6.7.4",
    "babel-eslint": "^10.1.0",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^11.0.0",
    "cross-env": "^7.0.3",
    "css-loader": "^6.8.1",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.3",
    "shx": "^0.3.4",
    "style-loader": "^3.3.3",
    "typescript": "^5.2.2",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "peerDependenciesMeta": {
    "@ohif/core": {
      "optional": false
    },
    "@ohif/ui": {
      "optional": false
    },
    "@ohif/i18n": {
      "optional": true
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "sideEffects": [
    "*.css",
    "src/init.ts"
  ],
  "ohif": {
    "extension": true,
    "version": "3.11.0-beta.58",
    "features": [
      "virtual-series",
      "global-patient-header",
      "study-comparison",
      "enhanced-toolbar",
      "prd-color-system"
    ],
    "compatibility": {
      "ohif": ">=3.8.0",
      "react": ">=18.0.0"
    }
  }
} 