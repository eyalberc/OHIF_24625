{
  "name": "@ohif/extension-ui-enhancements",
  "version": "3.11.0-beta.58",
  "description": "UI/UX Enhancement Extension for OHIF Viewer v3",
  "author": "OHIF Enhancement Team",
  "license": "MIT",
  "repository": "OHIF/Viewers",
  "main": "dist/ohif-extension-ui-enhancements.umd.js",
  "module": "src/index.ts",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18",
    "npm": ">=6",
    "yarn": ">=1.20.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "ohif-extension",
    "ui-enhancements",
    "medical-imaging"
  ],
  "scripts": {
    "clean": "shx rm -rf dist",
    "clean:deep": "yarn run clean && shx rm -rf node_modules",
    "dev": "cross-env NODE_ENV=development webpack --config .webpack/webpack.dev.js --watch --output-pathinfo",
    "build": "cross-env NODE_ENV=production webpack --config .webpack/webpack.prod.js",
    "build:package-1": "yarn run build",
    "start": "yarn run dev"
  },
  "peerDependencies": {
    "@ohif/core": "3.11.0-beta.58",
    "@ohif/ui": "3.11.0-beta.58",
    "@ohif/i18n": "3.11.0-beta.58",
    "prop-types": "^15.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "webpack": "5.89.0"
  },
  "dependencies": {
    "@babel/runtime": "^7.20.13",
    "lodash.get": "^4.4.2",
    "lodash.merge": "^4.6.2"
  }
} 